# mock: ダミーデータで動かす(サーバー不要) / supabase: 本物の Supabase につなぐ
EXPO_PUBLIC_DATA_MODE=mock
# true のとき、デバッグ画面に「ダミーとのすれ違い +1」などのデモ操作が出る
EXPO_PUBLIC_DEMO_MODE=true
# Supabase の接続先(supabase モードのときだけ使う)。publishable key はアプリに入る公開用の鍵なのでコミットしてよい
EXPO_PUBLIC_SUPABASE_URL=https://orhkiksbddaqaykgjmgp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1jtkXRy4OuWVKhMdzvLkuA_-vdHe6df
